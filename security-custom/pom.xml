    <artifactId>security-custom</artifactId>
    <packaging>pom</packaging>

    <!-- Custom orders: what ONE product asked of a security service that is otherwise neutral
         towards products. Each order is a module of its own — a vertical slice from the use case
         to the HTTP surface — that the application packages in, and another deployment may leave
         out. The neutral service never depends on anything in here. -->
    <modules>
        <module>custom-min-password-length</module>
    </modules>
</project>
