{
  "name": "security-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The auth service's own face — and the specs' third entry point: cucumber-js + Playwright drive the same Gherkin the JVM runners do, through this React UI.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "start": "vite",
    "build": "tsc && vite build",
    "e2e": "cucumber-js --config e2e/cucumber.mjs",
    "e2e:full": "./run-e2e.sh"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "typescript": "~5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
